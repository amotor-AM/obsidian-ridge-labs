# Gemini API Key for the AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Google Search Console (service account gsc-reader@money-sites-seo.iam.gserviceaccount.com).
# Locally the key is read from ~/.config/gsc/ with no setup. Set GSC_KEY_FILE to use a key elsewhere.
# CI uses GSC_CLIENT_EMAIL and GSC_PRIVATE_KEY repository secrets instead. See docs/SEARCH-CONSOLE.md.
# GSC_KEY_FILE=/path/to/service-account.json
