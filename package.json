  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-babylovegrowth-blog.mjs && vite",
    "build": "node scripts/sync-babylovegrowth-blog.mjs && vite build && vite build --ssr entry-server.tsx --outDir dist-server && node prerender.js && node scripts/copy-sites-worker.js",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "sync:babylovegrowth": "node scripts/sync-babylovegrowth-blog.mjs",
    "validate": "npm run validate:seo && npm run validate:worker",
    "validate:seo": "node scripts/validate-seo.js",
    "validate:worker": "node scripts/validate-worker.js",
    "gsc:report": "node scripts/search-console-report.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@google/genai": "^1.41.0",
    "babylovegrowth-next-js-blog": "^0.2.2",
    "clsx": "^2.1.1",
    "framer-motion": "11.0.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "0.344.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3",
    "tailwind-merge": "^3.6.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.14.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
